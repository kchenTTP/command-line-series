Output terminal.gif

Require echo
Require ls
Require cd

Set Shell "bash"
Set FontSize 26
Set FontFamily "iMWritingMono Nerd Font Mono"
Set Width 1200
Set Height 800
Set LineHeight 1.5
Set Theme "neobones_light"
Set BorderRadius 10
Set TypingSpeed 0.1

Type "echo 'Welcome to the terminal!'" Sleep 500ms  Enter

Sleep 1s

Type "cd ~/Documents" Sleep 500ms Enter

Sleep 1s

Type "ls -1" Sleep 500ms Enter

Sleep 4s
